{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "productos-workers-staging",
  "compatibility_date": "2026-10-09",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "workers/preview-entry.mjs",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": [
      "/__catalog-demo/*"
    ],
    "html_handling": "none"
  },
  "workers_dev": true,
  "limits": {
    "cpu_ms": 1000
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "PREVIEW_CATALOG_SNAPSHOT": "true"
  }
}
